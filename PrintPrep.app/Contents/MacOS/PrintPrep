#!/bin/bash
# PrintPrep launcher — starts the local web server and opens the browser.
# Quitting the app (Cmd+Q from the menu, or right-click in Dock -> Quit) stops the server.

set -e

# Resolve the project root. Tried in order, first match wins:
#   1) PRINTPREP_DIR env var (advanced users / CI).
#   2) Walk up from this script's location until a venv + pyproject.toml is found
#      (works when the .app sits inside the project checkout).
#   3) Cached choice from a previous launch (~/Library/Application Support/PrintPrep/project_path).
#   4) Ask the user with a folder picker, then cache the result.
HERE="$(cd "$(dirname "$0")" && pwd)"
PROJECT=""
CONFIG_DIR="$HOME/Library/Application Support/PrintPrep"
CONFIG_FILE="$CONFIG_DIR/project_path"

is_printprep_dir() {
    [ -f "$1/pyproject.toml" ] && [ -x "$1/venv/bin/printprep" ] && [ -x "$1/venv/bin/python" ]
}

if [ -n "${PRINTPREP_DIR}" ] && is_printprep_dir "$PRINTPREP_DIR"; then
    PROJECT="$PRINTPREP_DIR"
fi

if [ -z "$PROJECT" ]; then
    CANDIDATE="$HERE"
    for _ in 1 2 3 4 5; do
        CANDIDATE="$(dirname "$CANDIDATE")"
        if is_printprep_dir "$CANDIDATE"; then
            PROJECT="$CANDIDATE"
            break
        fi
    done
fi

if [ -z "$PROJECT" ] && [ -f "$CONFIG_FILE" ]; then
    CACHED="$(cat "$CONFIG_FILE" 2>/dev/null)"
    if is_printprep_dir "$CACHED"; then
        PROJECT="$CACHED"
    fi
fi

if [ -z "$PROJECT" ]; then
    PICKED="$(osascript -e 'POSIX path of (choose folder with prompt "Select your PrintPrep project folder (the one containing pyproject.toml and venv/)")' 2>/dev/null || true)"
    PICKED="${PICKED%/}"
    if [ -n "$PICKED" ] && is_printprep_dir "$PICKED"; then
        PROJECT="$PICKED"
        mkdir -p "$CONFIG_DIR"
        printf '%s\n' "$PROJECT" > "$CONFIG_FILE"
    else
        osascript -e 'display alert "PrintPrep" message "Selected folder is not a PrintPrep project (needs pyproject.toml and venv/). Run: pip install -e \".[web,desktop]\" inside the project, then try again."'
        exit 1
    fi
fi

LOG_DIR="$HOME/Library/Logs"
LOG="$LOG_DIR/printprep.log"
mkdir -p "$LOG_DIR"

cd "$PROJECT" || {
    osascript -e "display alert \"PrintPrep\" message \"Cannot find project at $PROJECT.\nSet PRINTPREP_DIR or rebuild the app.\""
    exit 1
}

PY="$PROJECT/venv/bin/printprep"
PYTHON="$PROJECT/venv/bin/python"
if [ ! -x "$PY" ] || [ ! -x "$PYTHON" ]; then
    osascript -e "display alert \"PrintPrep\" message \"venv not found at $PROJECT/venv. Run 'pip install -e .[web]' first.\""
    exit 1
fi

# Force native architecture so venv C-extensions (numpy etc.) load correctly.
# `uname -m` can lie when the .app is launched under Rosetta — ask the hardware.
if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
    NATIVE_ARCH="arm64"
else
    NATIVE_ARCH="x86_64"
fi
ARCH_PREFIX=(/usr/bin/arch "-${NATIVE_ARCH}")

# `printprep app` opens a native pywebview window; falls back to `serve` +
# default browser when the [desktop] extra isn't installed.
if "$PYTHON" -c "import webview" 2>/dev/null; then
    echo "--- $(date) PrintPrep app (project=$PROJECT, arch=$HOST_ARCH) ---" >> "$LOG"
    exec "${ARCH_PREFIX[@]}" "$PY" app >> "$LOG" 2>&1
fi

# Fallback: classic serve + browser tab.
URL="http://127.0.0.1:8000"
if curl -s -o /dev/null --max-time 1 "$URL/api/options" 2>/dev/null; then
    open "$URL"
    exit 0
fi
(sleep 1.5 && open "$URL") &
echo "--- $(date) PrintPrep serve fallback (project=$PROJECT, arch=$HOST_ARCH) ---" >> "$LOG"
exec "${ARCH_PREFIX[@]}" "$PY" serve --host 127.0.0.1 --port 8000 >> "$LOG" 2>&1
